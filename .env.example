# Copy to .env on the VPS (next to docker-compose.yml). Compose reads it
# automatically; do NOT commit your real .env.

# Random string used to sign JWTs. Generate once with `openssl rand -hex 32`
# and keep it stable — changing it invalidates every existing login token
# (everyone has to log in again).
SECRET_KEY=change-me-with-openssl-rand-hex-32

# --- Офсайт-копия ночных бэкапов (необязательно) ---
# Нет строк / пусто = выключено, локальные дампы в томе backups всё равно
# делаются. Приёмник — любой WebDAV; по решению хозяина НЕроссийский:
# Koofr (Preferences → Password → App Passwords — это отдельный app-пароль,
# НЕ пароль от аккаунта). Применять правки только через
# `docker compose up -d server`: restart перезапускает со старым env.
# BACKUP_WEBDAV_URL=https://app.koofr.net/dav/Koofr/gandola-backups
# BACKUP_WEBDAV_USER=you@example.com
# BACKUP_WEBDAV_PASSWORD=app-password-not-your-login-password

# --- «Нашёл баг, отправить логи» (необязательно) ---
# Кому из АДМИНОВ падают баг-репорты: ники (регистр/пробелы/подчёркивания
# не важны) и/или числовые id через запятую; не-админ в списке
# игнорируется. Без строки — хозяину (Papa Gandola, зашито в
# docker-compose.yml); пустая строка = всем админам. Применять тоже через
# `docker compose up -d server`.
# BUG_REPORT_TO=Papa Gandola, Костян

# --- Бот с нейросетью (b-AI-darka) ---
# Ключ Google AI Studio (aistudio.google.com → Get API key → Create API key).
# Бесплатный тариф Gemini; без ключа бот отвечает «ключ не настроен».
# Применять через `docker compose up -d server`. Остальное — по желанию.
# AI_API_KEY=AIza...
# AI_MODEL=gemini-3.5-flash
# Запасные модели через запятую: при 503 «перегружена» / 429 на основной
# бот после повтора пробует их по очереди. Какие доступны ключу:
#   curl -s -H "x-goog-api-key: $AI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
# (но проверять живым generateContent — в каталоге бывают снятые модели).
# AI_MODEL_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# AI_BOT_NAME=b-AI-darka
# AI_DAILY_LIMIT=60
