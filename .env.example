# Copy to .env on the VPS (next to docker-compose.yml). Compose reads it
# automatically; do NOT commit your real .env.

# Random string used to sign JWTs. Generate once with `openssl rand -hex 32`
# and keep it stable — changing it invalidates every existing login token
# (everyone has to log in again).
SECRET_KEY=change-me-with-openssl-rand-hex-32

# --- Офсайт-копия ночных бэкапов (необязательно) ---
# Нет строк / пусто = выключено, локальные дампы в томе backups всё равно
# делаются. Приёмник — любой WebDAV; по решению хозяина НЕроссийский:
# Koofr (Preferences → Password → App Passwords — это отдельный app-пароль,
# НЕ пароль от аккаунта). Применять правки только через
# `docker compose up -d server`: restart перезапускает со старым env.
# BACKUP_WEBDAV_URL=https://app.koofr.net/dav/Koofr/gandola-backups
# BACKUP_WEBDAV_USER=you@example.com
# BACKUP_WEBDAV_PASSWORD=app-password-not-your-login-password

# --- «Нашёл баг, отправить логи» (необязательно) ---
# Кому падают баг-репорты: ники (регистр не важен) и/или числовые id через
# запятую. Пусто = всем админам. Применять тоже через
# `docker compose up -d server`.
# BUG_REPORT_TO=gandola
